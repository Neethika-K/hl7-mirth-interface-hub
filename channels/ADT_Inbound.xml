          <script>// Check required segments, key fields, and dates.
// On any problem: log it to exceptions_log, then reject the message.
var val = function(x) { return String(x).replace(/^\s+|\s+$/g, &apos;&apos;); };

var validDate = function(s) {
    if (!/^\d{8}(\d{4}|\d{6})?$/.test(s)) { return false; }
    var y = parseInt(s.substring(0, 4), 10);
    var m = parseInt(s.substring(4, 6), 10);
    var d = parseInt(s.substring(6, 8), 10);
    var dt = new Date(y, m - 1, d);
    return dt.getFullYear() == y &amp;&amp; dt.getMonth() == m - 1 &amp;&amp; dt.getDate() == d;
};

var problems = [];   // each entry: [category, detail]

// 1. Required segments
var required = [&apos;MSH&apos;, &apos;PID&apos;, &apos;PV1&apos;];
for (var i = 0; i &lt; required.length; i++) {
    if (msg[required[i]].length() == 0) {
        problems.push([&apos;MISSING_SEGMENT&apos;, &apos;Missing required segment: &apos; + required[i]]);
    }
}

// 2. Header fields
var controlId = &apos;&apos;;
var msgType = &apos;&apos;;
if (msg[&apos;MSH&apos;].length() &gt; 0) {
    controlId = val(msg[&apos;MSH&apos;][&apos;MSH.10&apos;][&apos;MSH.10.1&apos;]);
    var t1 = val(msg[&apos;MSH&apos;][&apos;MSH.9&apos;][&apos;MSH.9.1&apos;]);
    var t2 = val(msg[&apos;MSH&apos;][&apos;MSH.9&apos;][&apos;MSH.9.2&apos;]);
    msgType = t1 + &apos;^&apos; + t2;
    if (t1 == &apos;&apos; || t2 == &apos;&apos;) {
        problems.push([&apos;MISSING_FIELD&apos;, &apos;MSH-9 message type is missing or incomplete&apos;]);
    }
    if (controlId == &apos;&apos;) {
        problems.push([&apos;MISSING_FIELD&apos;, &apos;MSH-10 message control ID is missing&apos;]);
    }
    var tsRaw = val(msg[&apos;MSH&apos;][&apos;MSH.7&apos;][&apos;MSH.7.1&apos;]);
    var ts = tsRaw.replace(/[^0-9].*$/, &apos;&apos;);
    if (tsRaw != &apos;&apos; &amp;&amp; !validDate(ts)) {
        problems.push([&apos;BAD_DATE&apos;, &apos;MSH-7 message timestamp is not a valid date: &apos; + tsRaw]);
    }
}

// 3. Patient fields
if (msg[&apos;PID&apos;].length() &gt; 0) {
    if (val(msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;]) == &apos;&apos;) {
        problems.push([&apos;MISSING_FIELD&apos;, &apos;PID-3 patient ID (MRN) is missing&apos;]);
    }
    if (val(msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;]) == &apos;&apos; || val(msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;]) == &apos;&apos;) {
        problems.push([&apos;MISSING_FIELD&apos;, &apos;PID-5 patient name is incomplete&apos;]);
    }
    var dob = val(msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;]);
    if (dob != &apos;&apos; &amp;&amp; !validDate(dob)) {
        problems.push([&apos;BAD_DATE&apos;, &apos;PID-7 date of birth is not a valid date: &apos; + dob]);
    }
}

// 4. Visit fields
if (msg[&apos;PV1&apos;].length() &gt; 0) {
    var admit = val(msg[&apos;PV1&apos;][&apos;PV1.44&apos;][&apos;PV1.44.1&apos;]);
    if (admit != &apos;&apos; &amp;&amp; !validDate(admit)) {
        problems.push([&apos;BAD_DATE&apos;, &apos;PV1-44 admit date/time is not valid: &apos; + admit]);
    }
}

if (problems.length == 0) {
    return true;
}

// Something is wrong: write one exceptions_log row for this message, then reject it
var cats = &apos;&apos;;
var seen = {};
var details = [];
for (var j = 0; j &lt; problems.length; j++) {
    if (!seen[problems[j][0]]) {
        seen[problems[j][0]] = true;
        cats += (cats == &apos;&apos; ? &apos;&apos; : &apos;, &apos;) + problems[j][0];
    }
    details.push(problems[j][1]);
}

var dbConn = null;
try {
    dbConn = DatabaseConnectionFactory.createDatabaseConnection(
        &apos;org.sqlite.JDBC&apos;,
        &apos;jdbc:sqlite:/path/to/MIRTH-PROJECT/sql/mirth.db&apos;,
        &apos;&apos;, &apos;&apos;);
    var p = new java.util.ArrayList();
    p.add(&apos;MLLP 6661&apos;);
    p.add(controlId);
    p.add(msgType);
    p.add(cats);
    p.add(details.join(&apos;; &apos;));
    p.add(String(connectorMessage.getRawData()));
    dbConn.executeUpdate(
        &quot;INSERT INTO exceptions_log (source_filename, message_control_id, message_type, &quot; +
        &quot;error_category, error_detail, raw_message) VALUES (?, ?, ?, ?, ?, ?)&quot;, p);
} catch (err) {
    // A logging failure must never let a bad message through
    logger.error(&apos;exceptions_log write failed: &apos; + err);
} finally {
    if (dbConn != null) { dbConn.close(); }
}
return false;</script>
