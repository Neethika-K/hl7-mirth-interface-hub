        p);

    // 2. Look up the patient_id for this MRN
    var m = new java.util.ArrayList();
    m.add(String($(&apos;mrn&apos;)));
    var rs = dbConn.executeCachedQuery(&quot;SELECT patient_id FROM patients WHERE mrn = ?&quot;, m);
    rs.next();
