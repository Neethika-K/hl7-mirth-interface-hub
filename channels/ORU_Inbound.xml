        &apos;jdbc:sqlite:/path/to/MIRTH-PROJECT/sql/mirth.db&apos;,
        &apos;&apos;, &apos;&apos;);

    // 1. Patient: insert, or refresh demographics if this MRN already exists
    var p = new java.util.ArrayList();
    p.add(String($(&apos;mrn&apos;)));
    p.add(String($(&apos;last_name&apos;)));
    p.add(String($(&apos;first_name&apos;)));
    p.add(String($(&apos;middle_name&apos;)));
    p.add(String($(&apos;date_of_birth&apos;)));
    p.add(String($(&apos;gender&apos;)));
    p.add(String($(&apos;address_street&apos;)));
    p.add(String($(&apos;address_city&apos;)));
    p.add(String($(&apos;address_state&apos;)));
    p.add(String($(&apos;address_zip&apos;)));
    p.add(String($(&apos;phone&apos;)));
    dbConn.executeUpdate(
        &quot;INSERT INTO patients (mrn, last_name, first_name, middle_name, date_of_birth, gender, &quot; +
        &quot;address_street, address_city, address_state, address_zip, phone) &quot; +
